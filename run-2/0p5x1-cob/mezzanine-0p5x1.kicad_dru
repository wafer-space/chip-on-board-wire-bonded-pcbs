(version 1)

# --- rev0fix rules (generated by tools/rev0fix/rev0fix.py) ---
# NextPCB Rev 0 flagged pad holes at 0.233 and 0.253 mm from a trace while passing vias at 0.23 mm,
# so pad (component) holes get their own, larger hole clearance.
(rule "rev0_pad_hole_to_copper"
  (condition "(A.Type == 'Pad' && A.Pad_Type == 'Through-hole') || (B.Type == 'Pad' && B.Pad_Type == 'Through-hole')")
  (constraint hole_clearance (min 0.31mm)))

(rule "rev0_hole_to_hole_diff_net"
  (condition "A.NetName != B.NetName")
  (constraint hole_to_hole (min 0.3048mm)))

# Hole spacing on U102 is disregarded by request (--ignore-fp U102). Copper clearance still applies.
(rule "rev0_ignore_U102"
  (condition "A.memberOfFootprint('U102') || B.memberOfFootprint('U102')")
  (constraint hole_clearance (min 0mm))
  (constraint hole_to_hole (min 0mm)))

# Vias and tracks may sit 0.45 mm from the edge (--edge); NextPCB's V-cut limit is 0.4 mm.
# The pour keeps the board's original 0.5 mm, so zone outlines don't change.
(rule "rev0_zone_edge"
  (condition "A.Type == 'Zone'")
  (constraint edge_clearance (min 0.5mm)))
# --- end rev0fix rules ---
